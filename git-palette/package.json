{
  "name": "git-palette",
  "description": "Scratch collaboration workflow: store the expanded tree of a .sb3 (roles/costumes/sounds + .palette) in git; a pre-commit hook auto-unpacks the .sb3 on commit. Run as `git palette`.",
  "version": "0.1.0",
  "type": "module",
  "license": "MPL-2.0",
  "bin": {
    "git-palette": "./src/index.js"
  },
  "files": [
    "src",
    "hooks"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test --test-timeout=120000 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@turbowarp/jszip": "^3.12.0",
    "commander": "^14.0.0",
    "parse-sb3-blocks": "github:palette-community/parse-sb3-blocks",
    "scratch-sandbox": "github:palette-community/scratch-sandbox"
  }
}
